<?xml version="1.0" encoding="utf-8"?>
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <!-- Hind Siliguri — Google Font supporting Bengali and Latin script -->
    <font
        app:fontStyle="normal"
        app:fontWeight="400"
        app:font="@font/hind_siliguri_regular"/>

    <font
        app:fontStyle="normal"
        app:fontWeight="600"
        app:font="@font/hind_siliguri_semibold"/>

    <font
        app:fontStyle="normal"
        app:fontWeight="700"
        app:font="@font/hind_siliguri_bold"/>

</font-family>
