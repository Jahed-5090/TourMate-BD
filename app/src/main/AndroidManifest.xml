<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TourMateBD">

        <!-- Splash Screen -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.TourMateBD.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Main / Home Screen -->
        <activity
            android:name=".activities.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Division List Screen -->
        <activity
            android:name=".activities.DivisionListActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- District List Screen -->
        <activity
            android:name=".activities.DistrictListActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Spot List Screen -->
        <activity
            android:name=".activities.SpotListActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- Spot Detail Screen -->
        <activity
            android:name=".activities.SpotDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

        <!-- About Screen -->
        <activity
            android:name=".activities.AboutActivity"
            android:exported="false"
            android:screenOrientation="portrait"/>

    </application>

</manifest>
