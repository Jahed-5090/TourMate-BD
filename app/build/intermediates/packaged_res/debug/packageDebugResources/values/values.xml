    <style name="Theme.TourMateBD" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorPrimaryDark">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/text_on_primary</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/text_primary</item>
        <item name="android:colorBackground">@color/bg_primary</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:windowLightStatusBar" ns1:targetApi="m">false</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
    </style>
    <style name="Theme.TourMateBD.Splash" parent="Theme.TourMateBD">
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:statusBarColor">@color/splash_start</item>
    </style>
    <style name="TourMate.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/brand_primary</item>
        <item name="android:textColor">@color/text_on_primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
    </style>
    <style name="TourMate.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/bg_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="cardMaxElevation">6dp</item>
    </style>
    <style name="TourMate.Card.Tip">
        <item name="cardBackgroundColor">@color/tip_bg</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/tip_border</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
    <style name="TourMate.Card.Warning">
        <item name="cardBackgroundColor">@color/warning_bg</item>
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">@color/warning_border</item>
        <item name="strokeWidth">1.5dp</item>
    </style>
    <style name="TourMate.TextAppearance" parent="TextAppearance.AppCompat"/>
    <style name="TourMate.TextAppearance.Body">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/hind_siliguri</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:lineSpacingMultiplier">1.5</item>
    </style>
    <style name="TourMate.TextAppearance.SectionHeader">
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">@font/hind_siliguri_semibold</item>
        <item name="android:textColor">@color/brand_primary</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="TourMate.TextAppearance.SpotTitle">
        <item name="android:textSize">22sp</item>
        <item name="android:fontFamily">@font/hind_siliguri_bold</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TourMate.Toolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/brand_primary</item>
        <item name="titleTextColor">@color/text_on_primary</item>
        <item name="subtitleTextColor">#B2FFFFFF</item>
    </style>
</resources>