<?xml version="1.0" encoding="utf-8"?>
<!-- Tourist Spot List Item -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- Spot Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/spot_image_size"
            android:layout_height="@dimen/spot_image_size"
            android:layout_gravity="center_vertical"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/iv_spot"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_spot"
                android:contentDescription="Spot image"/>

        </androidx.cardview.widget.CardView>

        <!-- Number Badge -->
        <TextView
            android:id="@+id/tv_spot_number"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="10dp"
            android:layout_gravity="top|center_vertical"
            android:background="@drawable/btn_primary_bg"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Bangla Name -->
            <TextView
                android:id="@+id/tv_spot_name_bn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="স্থানের নাম"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold"
                android:maxLines="2"
                android:ellipsize="end"/>

            <!-- English Name -->
            <TextView
                android:id="@+id/tv_spot_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Spot Name"
                android:textColor="@color/brand_primary"
                android:textSize="11sp"
                android:layout_marginTop="2dp"/>

            <!-- Category Badge -->
            <TextView
                android:id="@+id/tv_spot_category"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/btn_primary_bg"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="Natural"
                android:textColor="#FFFFFF"
                android:textSize="10sp"/>

            <!-- Short Description -->
            <TextView
                android:id="@+id/tv_spot_short_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Short description of the spot"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:maxLines="2"
                android:ellipsize="end"
                android:lineSpacingMultiplier="1.3"/>

        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_gravity="center_vertical"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_hint"
            android:contentDescription="Navigate"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
