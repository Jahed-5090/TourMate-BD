<?xml version="1.0" encoding="utf-8"?>
<!-- District Card Item -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/bg_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <!-- District Image -->
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/district_image_size"
            android:layout_height="@dimen/district_image_size"
            android:layout_gravity="center_vertical"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <ImageView
                android:id="@+id/iv_district"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/placeholder_spot"
                android:contentDescription="District image"/>

        </androidx.cardview.widget.CardView>

        <!-- Number Badge -->
        <TextView
            android:id="@+id/tv_district_number"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="12dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/btn_primary_bg"
            android:gravity="center"
            android:text="1"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"/>

        <!-- Text Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical"
            android:orientation="vertical">

            <!-- Bangla Name -->
            <TextView
                android:id="@+id/tv_district_name_bn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সিলেট"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <!-- English Name -->
            <TextView
                android:id="@+id/tv_district_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sylhet"
                android:textColor="@color/brand_primary"
                android:textSize="12sp"
                android:layout_marginTop="2dp"/>

            <!-- Description -->
            <TextView
                android:id="@+id/tv_district_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="District description"
                android:textColor="@color/text_secondary"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end"/>

        </LinearLayout>

        <!-- Chevron -->
        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:src="@drawable/ic_chevron_right"
            android:tint="@color/text_hint"
            android:contentDescription="Navigate"/>

    </LinearLayout>

</androidx.cardview.widget.CardView>
