<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    app:statusBarBackground="@color/brand_primary_dark">

    <!-- Main Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/bg_primary">

        <!-- Top Header Area (Unified continuous Ocean Blue Gradient) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/header_ocean_background"
            android:elevation="4dp">

            <!-- Toolbar with White Hamburger Menu Icon and Theme Toggle in Top-Right Corner -->
            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="?attr/actionBarSize"
                android:background="@android:color/transparent"
                app:titleTextColor="#FFFFFF"
                app:navigationIconTint="#FFFFFF"
                app:popupTheme="@style/ThemeOverlay.MaterialComponents.Light">

                <ImageButton
                    android:id="@+id/btn_theme_toggle"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_theme_toggle_btn"
                    android:src="@drawable/ic_mode_night"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:contentDescription="Dark or Light Mode Toggle"/>

            </androidx.appcompat.widget.Toolbar>

            <!-- Offline Status Banner (Topic 10: Broadcast Receiver) -->
            <LinearLayout
                android:id="@+id/layout_offline_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#D32F2F"
                android:padding="8dp"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⚠️ আপনি অফলাইনে আছেন (Offline Mode) — সেভ করা ডেটা কাজ করবে"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- Header Banner Content -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="4dp"
                android:paddingBottom="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="বাংলাদেশ ভ্রমণ গাইড"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="বিভাগ অনুযায়ী ব্রাউজ করুন"
                    android:textColor="#E0F2FE"
                    android:textSize="13sp"/>

                <!-- Live Weather Badge (Topic 11: HTTP API + JSON) -->
                <LinearLayout
                    android:id="@+id/layout_weather"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/badge_bg"
                    android:backgroundTint="#2EFFFFFF"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="5dp"
                    android:paddingBottom="5dp"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tv_weather_temp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⛅ আবহাওয়া লোড হচ্ছে..."
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold"/>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- RecyclerView for Divisions Grid -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_divisions"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:padding="12dp"
            android:clipToPadding="false"/>

    </LinearLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@color/bg_card"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/nav_item_icon_tint"
        app:itemTextColor="@color/nav_item_text_tint"
        app:itemBackground="@drawable/nav_item_background"
        app:itemIconSize="22dp"
        app:itemHorizontalPadding="16dp"
        app:itemIconPadding="16dp"/>

</androidx.drawerlayout.widget.DrawerLayout>
